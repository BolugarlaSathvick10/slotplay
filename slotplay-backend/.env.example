# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-64-random-chars-in-production
SESSION_SECURE=false         # set true in production (HTTPS)
SESSION_MAX_AGE_DAYS=7

# Frontend app URL used for CORS and generated links
FRONTEND_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SlotPlay <onboarding@resend.dev>
# Production: EMAIL_FROM=SlotPlay <noreply@yourdomain.com>

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_ADAPTER=local        # local | cloudinary
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=5

# Cloudinary (optional — only needed when STORAGE_ADAPTER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud
# CLOUDINARY_API_KEY=your_key
# CLOUDINARY_API_SECRET=your_secret

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100
