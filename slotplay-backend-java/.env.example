# ==============================================================================
# SlotPlay Spring Boot Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set environment variables in your deployment environment.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.

# --- Server Configuration ---
PORT=4000
SPRING_PROFILES_ACTIVE=dev

# --- Database Configuration (Neon PostgreSQL) ---
# Format: jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/slotplay
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# --- Session & Security Configuration ---
# Cookie name MUST match slotplay.sid to preserve frontend session compatibility
SESSION_SECRET=change-this-to-a-secure-random-64-character-secret-in-production
SESSION_MAX_AGE_MS=604800000

# --- CORS & Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Email Integration (Resend) ---
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=SlotPlay <slotplay@nmart.me>

# --- Storage Configuration ---
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Optional: Cloudinary (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
